{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "customrules.readysetink.com"
        }
      ],
      "destination": "/customrules/index.html"
    },
    {
      "source": "/(app\\.js|app\\.css|rules\\.js|formats\\.json)",
      "has": [
        {
          "type": "host",
          "value": "customrules.readysetink.com"
        }
      ],
      "destination": "/customrules/$1"
    },
    {
      "source": "/deckbuilder",
      "destination": "/index.html"
    },
    {
      "source": "/img/lorcast/:path*",
      "destination": "https://cards.lorcast.io/:path*"
    },
    {
      "source": "/img/rav/:path*",
      "destination": "https://api.lorcana.ravensburger.com/images/:path*"
    }
  ],
  "headers": [
    {
      "source": "/img/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/card/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        }
      ]
    },
    {
      "source": "/icons/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/deckbuilder/",
      "destination": "/deckbuilder",
      "permanent": false
    }
  ]
}
